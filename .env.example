DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"
# Used for product bounding-box/hotspot detection on generated designs.
ANTHROPIC_API_KEY=""
ANTHROPIC_VISION_MODEL="claude-sonnet-4-5"
# Used for room-design image generation/editing (Flux Kontext Pro via Replicate).
REPLICATE_API_TOKEN=""
REPLICATE_IMAGE_MODEL="black-forest-labs/flux-kontext-pro"
# Used for room-photo uploads (Vercel Blob). Create a store with
# `vercel blob create-store <name> --access public` and link it to the
# project, or copy the token from the Vercel dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=""
